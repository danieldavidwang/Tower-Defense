entrypoint = "run.py"
modules = ["python-3.12"]
run = "python3 run.py"

[packager]
language = "python3"

[packager.features]
guessImports = true
packageSearch = true
enabledForHosting = false

[workflows]
runButton = "Run Tower Defense"

[[workflows.workflow]]
name = "Run Tower Defense"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 run.py"

[workflows.workflow.metadata]
outputType = "vnc"
