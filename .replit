entrypoint = "run.py"
modules = ["python-3.12"]
run = "python3 run.py"

[packager]
language = "python3"

[packager.features]
guessImports = true
packageSearch = true
enabledForHosting = false

[deployment]
build = "python3 -m pip install -r requirements-web.txt && python3 -m pygbag --build --width 900 --height 700 --title 'Tower Defense' --ume_block 0 ."
run = ["python3", "-m", "http.server", "8080", "--directory", "build/web", "--bind", "0.0.0.0"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8080
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Tower Defense"

[[workflows.workflow]]
name = "Start Tower Defense"
author = "agent"

[workflows.workflow.metadata]
outputType = "vnc"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f 'Xvnc :1' 2>/dev/null || true; pkill -f 'rfbproxy --address 0.0.0.0:5900' 2>/dev/null || true; Xvnc :1 -rfbport=5901 -SecurityTypes=None -BlacklistTimeout=0 -BlacklistThreshold=1000000000 -geometry 900x700 -localhost >/tmp/tower-defense-xvnc.log 2>&1 & rfbproxy --address 0.0.0.0:5900 --rfb-server 127.0.0.1:5901 >/tmp/tower-defense-rfbproxy.log 2>&1 & exec env DISPLAY=:1 python3 run.py"
